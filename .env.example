APP_NAME="Kijura Town Council"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Render provides DATABASE_URL automatically for PostgreSQL.
# Laravel reads it via DB_URL below (Laravel 11+).
DB_CONNECTION=pgsql
DB_URL="${DATABASE_URL}"

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@kijuratowncouncil.go.ug"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: set these in the Render dashboard
COUNCIL_NAME="Kijura Town Council"
