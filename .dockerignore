# Git
.git
.gitignore
.gitattributes

# Environment files — secrets never go into the image
.env
.env.backup
.env.production

# Dev dependencies
vendor
node_modules

# Built assets (regenerated by composer install inside Docker)
/public/build
/public/hot

# Storage — runtime data, not code
storage/app/public/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*

# Keep .gitkeep files so directories exist
!storage/app/public/.gitkeep
!storage/framework/cache/data/.gitkeep
!storage/framework/sessions/.gitkeep
!storage/framework/views/.gitkeep
!storage/logs/.gitkeep

# Bootstrap cache — regenerated at startup
bootstrap/cache/*.php

# Test files
tests
phpunit.xml
.phpunit.cache
.phpunit.result.cache

# Dev tools
.editorconfig
.npmrc
.phpactor.json
_ide_helper.php

# Docker build context extras
DEPLOYMENT.md
README.md
AGENTS.md
CLAUDE.md

# OS junk
.DS_Store
Thumbs.db
*.log
