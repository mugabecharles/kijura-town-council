APP_NAME="Kijura Town Council"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=error

# MySQL — injected by entrypoint.sh at container start
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kijura_council
DB_USERNAME=kijura
DB_PASSWORD=KijuraDb2026!

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@kijuratowncouncil.go.ug"
MAIL_FROM_NAME="${APP_NAME}"
